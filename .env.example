# Optional: collection interval in seconds (default: 3600)
NEWSBOT_POLL_SECONDS=3600

# Optional: Groq enables event analysis and Russian drafts.
# Keep the real key in your local .env; never commit it.
GROQ_API_KEY=
FILTER_MODEL=openai/gpt-oss-120b
VISION_MODEL=qwen/qwen3.8-27b

# Clear copied RSS excerpts after 30 days for terminal events.
NEWSBOT_RAW_RETENTION_DAYS=30

# Telegram publishing is manual: workflow --publish EVENT_ID
BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# Optional: start a private chat with the bot using /start to receive your chat ID.
TELEGRAM_REVIEW_CHAT_ID=

# Remove post-specific image files after terminal events age out; published files are removed immediately.
NEWSBOT_IMAGE_RETENTION_DAYS=30

# Autonomous mode: the bot auto-approves review-ready events and publishes them
# without the private Telegram review buttons. Set "false" to restore manual
# approve/reject before publication.
NEWSBOT_AUTOPUBLISH_ENABLED=true
# Max interesting_news posts per Moscow day (overrides editorial.yaml daily_limit).
NEWSBOT_AUTOPUBLISH_DAILY_LIMIT=6
